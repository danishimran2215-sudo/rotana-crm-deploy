# Required Owner Unlock & Domain License (Ask owner for values)
CRM_MASTER_KEY=
CRM_LICENSE_TOKEN=

# Server Runtime
PORT=4100
JWT_SECRET=

# Copy this file to backend/.env and fill in the values from Meta Business Manager.
# Never commit backend/.env — it holds your WhatsApp access token.

# WhatsApp Business Cloud API (official Business number)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# APPROVED message template (business-initiated messages require one).
# The template body must have 6 variables in this order:
#   {{1}} customer name  {{2}} car model  {{3}} plate number
#   {{4}} contract no    {{5}} return date  {{6}} return time
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Exact approved template text — only used for the on-screen review preview.
# Must match what Meta approved, or the preview will differ from what customers receive.
# WHATSAPP_TEMPLATE_BODY=Dear {{1}}, this is a friendly reminder from Rotana Star Rent A Car that your rental (Contract {{4}}) for {{2}} (Plate {{3}}) is due for return on {{5}} at {{6}}. Please contact us if you need an extension. Thank you.

# Delivery status (Sent -> Delivered / Failed) arrives via webhook:
#   Callback URL: https://YOUR-PUBLIC-DOMAIN/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
